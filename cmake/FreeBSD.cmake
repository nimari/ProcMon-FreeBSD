# SPDX-License-Identifier: MIT
# Selected before all Linux dependencies, fetches, embedded eBPF and packaging.
cmake_minimum_required(VERSION 3.20)
project(procmon VERSION 2.2.2.1 LANGUAGES C CXX)
if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(amd64|x86_64)$")
    message(FATAL_ERROR "The native FreeBSD port currently supports amd64 only")
endif()
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_INSTALL_MANDIR "share/man" CACHE PATH "Manual directory")
include(GNUInstallDirs)
include(CTest)
option(PROCMON_USE_SYSTEM_SQLITE "Use an installed SQLite library instead of the bundled copy" OFF)
option(PROCMON_USE_SYSTEM_EASYLOGGINGPP "Compile installed Easylogging++ source instead of the bundled copy" OFF)
option(PROCMON_INSTALL_DOCS "Install supplemental FreeBSD documentation" ON)
find_package(Threads REQUIRED)
set(PROCMON_CURSES_ROOT "/usr" CACHE PATH "Prefix supplying matching wide curses/panel headers and libraries")
if(NOT IS_ABSOLUTE "${PROCMON_CURSES_ROOT}")
    message(FATAL_ERROR "PROCMON_CURSES_ROOT must be an absolute prefix")
endif()
# Re-resolve on every configure so changing providers cannot retain old cache entries.
foreach(entry FREEBSD_CURSES_INCLUDE_DIR FREEBSD_CURSES FREEBSD_PANEL FREEBSD_WIDE_CURSES)
    unset(${entry} CACHE)
    unset(${entry})
endforeach()
find_path(FREEBSD_CURSES_INCLUDE_DIR NAMES ncurses.h
    PATHS "${PROCMON_CURSES_ROOT}/include/ncursesw" "${PROCMON_CURSES_ROOT}/include/ncurses" "${PROCMON_CURSES_ROOT}/include"
    NO_DEFAULT_PATH REQUIRED)
if(NOT EXISTS "${FREEBSD_CURSES_INCLUDE_DIR}/panel.h")
    message(FATAL_ERROR "The selected curses header directory must also supply panel.h")
endif()
# The ports provider uses unsuffixed names for its wide-character libraries.
find_library(FREEBSD_CURSES NAMES ncursesw ncurses PATHS "${PROCMON_CURSES_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
find_library(FREEBSD_PANEL NAMES panelw panel PATHS "${PROCMON_CURSES_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
include(CheckCXXSourceCompiles)
include(CMakePushCheckState)
cmake_push_check_state(RESET)
set(CMAKE_REQUIRED_INCLUDES "${FREEBSD_CURSES_INCLUDE_DIR}")
set(CMAKE_REQUIRED_LIBRARIES "${FREEBSD_PANEL}" "${FREEBSD_CURSES}")
set(CMAKE_REQUIRED_DEFINITIONS -D_XOPEN_SOURCE_EXTENDED=1)
check_cxx_source_compiles([[
#include <ncurses.h>
#include <panel.h>
#if !defined(NCURSES_WIDECHAR) || !NCURSES_WIDECHAR
#error Wide-character curses is required
#endif
int main() {
    cchar_t character{};
    WINDOW* window = nullptr;
    (void)wadd_wch(window, &character);
    PANEL* panel = new_panel(window);
    return del_panel(panel);
}
]] FREEBSD_WIDE_CURSES)
cmake_pop_check_state()
if(NOT FREEBSD_WIDE_CURSES)
    message(FATAL_ERROR "The selected curses/panel headers and libraries must support wide characters")
endif()
add_library(procmon_freebsd_terminal INTERFACE)
target_include_directories(procmon_freebsd_terminal INTERFACE "${FREEBSD_CURSES_INCLUDE_DIR}")
target_compile_definitions(procmon_freebsd_terminal INTERFACE _XOPEN_SOURCE_EXTENDED=1)
target_link_libraries(procmon_freebsd_terminal INTERFACE "${FREEBSD_PANEL}" "${FREEBSD_CURSES}")
set(FREEBSD_APP "${CMAKE_CURRENT_SOURCE_DIR}/src/tracer/freebsd/app")
add_library(procmon_freebsd_logging INTERFACE)
target_compile_definitions(procmon_freebsd_logging INTERFACE ELPP_THREAD_SAFE ELPP_NO_DEFAULT_LOG_FILE)
if(PROCMON_USE_SYSTEM_EASYLOGGINGPP)
    find_path(PROCMON_EASYLOGGINGPP_INCLUDE_DIR NAMES easylogging++.h REQUIRED)
    set(FREEBSD_LOGGING_SOURCE "${PROCMON_EASYLOGGINGPP_INCLUDE_DIR}/easylogging++.cc")
    if(NOT EXISTS "${PROCMON_EASYLOGGINGPP_INCLUDE_DIR}/easylogging++.h" OR
       NOT EXISTS "${FREEBSD_LOGGING_SOURCE}")
        message(FATAL_ERROR "System Easylogging++ requires co-located easylogging++.h and easylogging++.cc")
    endif()
    set(PROCMON_EASYLOGGINGPP_LICENSE_FILE "" CACHE FILEPATH "MIT license for the selected system Easylogging++ source")
    if(NOT PROCMON_EASYLOGGINGPP_LICENSE_FILE)
        get_filename_component(logging_prefix "${PROCMON_EASYLOGGINGPP_INCLUDE_DIR}" DIRECTORY)
        file(GLOB logging_licenses "${logging_prefix}/share/licenses/easyloggingpp-*/MIT")
        list(LENGTH logging_licenses logging_license_count)
        if(logging_license_count EQUAL 1)
            list(GET logging_licenses 0 PROCMON_EASYLOGGINGPP_LICENSE_FILE)
        endif()
    endif()
    if(NOT EXISTS "${PROCMON_EASYLOGGINGPP_LICENSE_FILE}" OR IS_DIRECTORY "${PROCMON_EASYLOGGINGPP_LICENSE_FILE}")
        message(FATAL_ERROR "Set PROCMON_EASYLOGGINGPP_LICENSE_FILE to the selected system logger's MIT license")
    endif()
    set(FREEBSD_LOGGING_LICENSE "${PROCMON_EASYLOGGINGPP_LICENSE_FILE}")
    target_include_directories(procmon_freebsd_logging INTERFACE "${PROCMON_EASYLOGGINGPP_INCLUDE_DIR}")
    target_compile_definitions(procmon_freebsd_logging INTERFACE PROCMON_USE_SYSTEM_EASYLOGGINGPP=1)
else()
    set(FREEBSD_LOGGING_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/src/logging/easylogging++.cc")
    set(FREEBSD_LOGGING_LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/dist/freebsd/EASYLOGGINGPP-LICENSE")
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/src")
configure_file("${FREEBSD_APP}/version.h.in" "${CMAKE_CURRENT_BINARY_DIR}/src/version.h" @ONLY)
if(PROCMON_USE_SYSTEM_SQLITE)
    find_package(SQLite3 3.33.0 REQUIRED)
    set(FREEBSD_SQLITE_TARGET SQLite::SQLite3)
else()
    add_library(procmon_freebsd_sqlite STATIC vendor/sqlite3/sqlite3.c)
    target_include_directories(procmon_freebsd_sqlite PUBLIC vendor/sqlite3)
    target_link_libraries(procmon_freebsd_sqlite PUBLIC Threads::Threads)
    set(FREEBSD_SQLITE_TARGET procmon_freebsd_sqlite)
endif()
add_library(procmon_freebsd_transport STATIC src/tracer/freebsd/dtrace_session.cpp src/tracer/freebsd/syscall_metadata.cpp
    src/tracer/freebsd/native_capture.cpp src/tracer/freebsd/native_program.cpp src/tracer/freebsd/native_event_decoder.cpp)
target_link_libraries(procmon_freebsd_transport PUBLIC dtrace ctf Threads::Threads)
add_library(procmon_freebsd_core STATIC "${FREEBSD_APP}/event.cpp" "${FREEBSD_APP}/storage.cpp" "${FREEBSD_APP}/capture.cpp"
    "${FREEBSD_APP}/engine.cpp" "${FREEBSD_APP}/symbols.cpp" "${FREEBSD_APP}/output.cpp" src/common/printable.cpp)
target_compile_definitions(procmon_freebsd_core PUBLIC NCURSES_NOMACROS=1)
target_link_libraries(procmon_freebsd_core PUBLIC procmon_freebsd_transport ${FREEBSD_SQLITE_TARGET} procmon_freebsd_logging procmon_freebsd_terminal procstat elf)
add_executable(procmon "${FREEBSD_APP}/main.cpp" "${FREEBSD_APP}/configuration.cpp" "${FREEBSD_APP}/formatter.cpp"
    "${FREEBSD_APP}/headless.cpp" "${FREEBSD_APP}/cli.cpp" src/display/screen.cpp src/display/column.cpp "${FREEBSD_LOGGING_SOURCE}")
target_include_directories(procmon PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/src")
target_link_libraries(procmon PRIVATE procmon_freebsd_core)
foreach(target procmon procmon_freebsd_transport procmon_freebsd_core)
    target_compile_options(${target} PRIVATE -fno-omit-frame-pointer -Wall -Wextra
        -Wno-unused-parameter -Wno-sign-compare -Wno-delete-non-abstract-non-virtual-dtor -Wno-misleading-indentation)
endforeach()
if(BUILD_TESTING)
    add_executable(test_freebsd_ui tests/freebsd/test_application_ui.cpp)
    target_link_libraries(test_freebsd_ui PRIVATE util Threads::Threads)
    add_executable(test_freebsd_runtime tests/freebsd/test_application_runtime.cpp)
    target_link_libraries(test_freebsd_runtime PRIVATE Threads::Threads)
    add_executable(freebsd_app_fixture tests/freebsd/target_fixture.c)
    target_compile_definitions(freebsd_app_fixture PRIVATE PROCMON_APP_FIXTURE_TIMEOUT=90)
    add_executable(freebsd_advanced_fixture tests/freebsd/application_fixture.c)
    target_compile_options(freebsd_app_fixture PRIVATE -g -fno-omit-frame-pointer)
    target_compile_options(freebsd_advanced_fixture PRIVATE -g -fno-omit-frame-pointer)
    target_link_libraries(freebsd_app_fixture PRIVATE Threads::Threads)
    target_link_libraries(freebsd_advanced_fixture PRIVATE Threads::Threads)
    add_executable(test_freebsd_storage tests/freebsd/test_app_storage.cpp)
    target_link_libraries(test_freebsd_storage PRIVATE procmon_freebsd_core)
    add_test(NAME freebsd-app-storage COMMAND ${CMAKE_COMMAND} -DTEST_EXECUTABLE=$<TARGET_FILE:test_freebsd_storage>
        -DTEST_PARENT=${CMAKE_CURRENT_BINARY_DIR} -P ${CMAKE_CURRENT_SOURCE_DIR}/tests/freebsd/run_storage_test.cmake)
    foreach(pair "program|test_native_program" "decoder|test_native_event_decoder" "controller|test_native_capture"
        "guard-program|test_target_program" "diagnostic-support|test_diagnostic_support")
        string(REPLACE "|" ";" values "${pair}")
        list(GET values 0 name)
        list(GET values 1 source)
        add_executable(test_freebsd_${source} "tests/freebsd/${source}.cpp")
        target_link_libraries(test_freebsd_${source} PRIVATE procmon_freebsd_transport)
        add_test(NAME freebsd-${name} COMMAND test_freebsd_${source})
    endforeach()
    add_executable(test_freebsd_watch tests/freebsd/test_target_watch.cpp)
    target_link_options(test_freebsd_watch PRIVATE -Wl,--wrap=sysctl,--wrap=sysctlbyname,--wrap=kevent)
    add_test(NAME freebsd-target-watch COMMAND test_freebsd_watch)
endif()
install(TARGETS procmon RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
find_program(FREEBSD_GZIP gzip REQUIRED)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/dist/freebsd/procmon.1")
execute_process(COMMAND "${FREEBSD_GZIP}" -n -c "${CMAKE_CURRENT_SOURCE_DIR}/dist/freebsd/procmon.1"
    OUTPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/procmon.1.gz" RESULT_VARIABLE manual_result)
if(NOT manual_result EQUAL 0)
    message(FATAL_ERROR "Cannot compress native manual")
endif()
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/procmon.1.gz" DESTINATION ${CMAKE_INSTALL_MANDIR}/man1)
install(FILES LICENSE dist/freebsd/SQLITE-NOTICE DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/procmon-freebsd)
install(FILES "${FREEBSD_LOGGING_LICENSE}" DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/procmon-freebsd RENAME EASYLOGGINGPP-LICENSE)
if(PROCMON_INSTALL_DOCS)
    install(FILES dist/freebsd/README.md DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/procmon-freebsd)
endif()
